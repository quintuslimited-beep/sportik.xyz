  const SPORTSDB_BASE = 'https://www.thesportsdb.com/api/v1/json/3';

  async function fetchLiveTeamResult(teamName){
    try{
      const searchRes = await fetch(`${SPORTSDB_BASE}/searchteams.php?t=${encodeURIComponent(teamName)}`);
      const searchData = await searchRes.json();
      const team = searchData && searchData.teams && searchData.teams[0];
      if(!team) return null;
      const eventsRes = await fetch(`${SPORTSDB_BASE}/eventslast.php?id=${team.idTeam}`);
      const eventsData = await eventsRes.json();
      const last = eventsData && eventsData.results && eventsData.results[0];
      if(!last || last.intHomeScore === null || last.intAwayScore === null) return null;
      const isHome = last.strHomeTeam === team.strTeam;
      const gf = parseInt(isHome ? last.intHomeScore : last.intAwayScore);
      const ga = parseInt(isHome ? last.intAwayScore : last.intHomeScore);
      const opponent = isHome ? last.strAwayTeam : last.strHomeTeam;
      const result = gf > ga ? 'W' : gf < ga ? 'L' : 'D';
      return { result, gf, ga, opponent };
    } catch(e){
      return null; // blocked by CSP, offline, or team not found — caller falls back to simulated data
    }
  }

