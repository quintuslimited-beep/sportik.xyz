<script>
(function(){

  // ---------------- Mock data ----------------
  const palette = ['#1FD9B0','#5B8DEF','#C9A54E','#E8735F','#8B7FE8','#4FBFD1','#D97757','#6FCF97'];
  function colorFor(i){ return palette[i % palette.length]; }

  const ASSETS = [
    { id:'mcfc', name:'Manchester City', ticker:'MCFC', sport:'EPL', type:'Team', base:142.30 },
    { id:'ars',  name:'Arsenal',         ticker:'ARS',  sport:'EPL', type:'Team', base:118.60 },
    { id:'liv',  name:'Liverpool',       ticker:'LIV',  sport:'EPL', type:'Team', base:131.90 },
    { id:'mufc', name:'Manchester United', ticker:'MUFC', sport:'EPL', type:'Team', base:96.40 },
    { id:'che',  name:'Chelsea',         ticker:'CHE',  sport:'EPL', type:'Team', base:88.10 },
    { id:'haal', name:'Erling Haaland',  ticker:'HAAL', sport:'EPL', type:'Player', base:64.20 },
    { id:'salah',name:'Mohamed Salah',   ticker:'SALA', sport:'EPL', type:'Player', base:58.70 },
    { id:'saka', name:'Bukayo Saka',     ticker:'SAKA', sport:'EPL', type:'Player', base:47.50 },
    { id:'kc',   name:'Kansas City Chiefs', ticker:'KC', sport:'NFL', type:'Team', base:151.80 },
    { id:'phi',  name:'Philadelphia Eagles', ticker:'PHI', sport:'NFL', type:'Team', base:112.40 },
    { id:'sf',   name:'San Francisco 49ers', ticker:'SF', sport:'NFL', type:'Team', base:104.90 },
    { id:'maho', name:'Patrick Mahomes', ticker:'MAHO', sport:'NFL', type:'Player', base:71.30 },
    { id:'jeff', name:'Justin Jefferson',ticker:'JEFF', sport:'NFL', type:'Player', base:52.60 },

    { id:'lal',  name:'Los Angeles Lakers', ticker:'LAL', sport:'NBA', type:'Team', base:126.70 },
    { id:'bos',  name:'Boston Celtics',     ticker:'BOS', sport:'NBA', type:'Team', base:134.20 },
    { id:'gsw',  name:'Golden State Warriors', ticker:'GSW', sport:'NBA', type:'Team', base:98.50 },
    { id:'den',  name:'Denver Nuggets',     ticker:'DEN', sport:'NBA', type:'Team', base:108.90 },
    { id:'lebron', name:'LeBron James',     ticker:'LBJ',  sport:'NBA', type:'Player', base:66.40 },
    { id:'curry',  name:'Stephen Curry',    ticker:'CURY', sport:'NBA', type:'Player', base:61.80 },

    { id:'rbr',  name:'Red Bull Racing', ticker:'RBR', sport:'F1', type:'Team', base:172.40 },
    { id:'fer',  name:'Ferrari',         ticker:'FER', sport:'F1', type:'Team', base:139.60 },
    { id:'mer',  name:'Mercedes',        ticker:'MER', sport:'F1', type:'Team', base:121.30 },
    { id:'mcl',  name:'McLaren',         ticker:'MCL', sport:'F1', type:'Team', base:114.80 },
    { id:'verst',name:'Max Verstappen',  ticker:'VER', sport:'F1', type:'Player', base:82.90 },
    { id:'norris',name:'Lando Norris',   ticker:'NOR', sport:'F1', type:'Player', base:57.20 },

    { id:'djok', name:'Novak Djokovic',   ticker:'DJOK', sport:'Tennis', type:'Player', base:74.50 },
    { id:'alcz', name:'Carlos Alcaraz',   ticker:'ALCZ', sport:'Tennis', type:'Player', base:69.10 },
    { id:'swia', name:'Iga Swiatek',      ticker:'SWIA', sport:'Tennis', type:'Player', base:63.30 },
    { id:'saba', name:'Aryna Sabalenka',  ticker:'SABA', sport:'Tennis', type:'Player', base:58.90 },
  ];

  // seeded-ish random walk generator
  function seedRand(seed){
    let s = seed;
    return function(){ s = (s*9301+49297)%233280; return s/233280; };
  }

  function genHistory(base, points, seed){
    const rand = seedRand(seed);
    let price = base * (0.85 + rand()*0.1);
    const arr = [];
    for(let i=0;i<points;i++){
      const drift = (rand()-0.485) * base * 0.018;
      price = Math.max(base*0.4, price + drift);
      arr.push(price);
    }
    arr[arr.length-1] = base; // land on current base
    return arr;
  }

  function mockAddress(seed){
    const chars = '0123456789abcdef';
    const r = seedRand(seed);
    let hex = '';
    for(let i=0;i<40;i++) hex += chars[Math.floor(r()*16)];
    return '0x' + hex;
  }

  const OPPONENTS_EPL = ['Everton','Spurs','Aston Villa','Brighton','Fulham','Newcastle'];
  const OPPONENTS_NFL = ['Bills','Ravens','Cowboys','Dolphins','Bengals','Broncos'];
  const OPPONENTS_NBA = ['Bucks','Suns','Heat','76ers','Timberwolves','Mavericks'];
  const RACES_F1 = ['Monaco GP','Silverstone GP','Monza GP','Suzuka GP','Interlagos GP','Singapore GP'];
  const TOURNAMENTS_TENNIS = ['Rome Masters','Wimbledon','US Open','Australian Open','Roland Garros','Cincinnati Open'];
  const ROUNDS_TENNIS = ['R32','R16','QF','SF','F'];
  const GAMEWEEK = 6;

  ASSETS.forEach((a,i)=>{
    a.color = colorFor(i);
    a.contract = mockAddress(i*31+5);
    a.oracleAddr = mockAddress(i*31+500);
    a.history = { '1D': genHistory(a.base, 48, i*7+1), '1W': genHistory(a.base, 42, i*7+2),
                  '1M': genHistory(a.base, 60, i*7+3), '1Y': genHistory(a.base, 90, i*7+4) };
    a.spark = genHistory(a.base, 24, i*7+9);
    a.price = a.base;
    a.change24h = (Math.random()*10 - 4.5);
    a.marketCap = a.base * (1_800_000 + Math.random()*3_200_000);
    a.volume24h = a.marketCap * (0.02 + Math.random()*0.08);
    a.holders = Math.floor(4000 + Math.random()*38000);
    a.supply = Math.floor(a.marketCap / a.base);

    // weekly on-field performance, drives price alongside the AMM curve
    const r = seedRand(i*53+13);
    const roll = r();

    if(a.type === 'Match'){
      a.gwResult = 'D';
      a.gwLine = `${a.fixture} · ${a.kickoff}`;
      a.gwImpact = 0;
      a.liveEligible = false;
    } else if(a.sport === 'F1'){
      // race sport — no fixed opponent, graded by finishing position instead of W/D/L
      const race = RACES_F1[Math.floor(r()*RACES_F1.length)];
      const pos = 1 + Math.floor(r()*10);
      a.gwResult = pos<=3 ? 'W' : pos<=6 ? 'D' : 'L';
      a.gwLine = `P${pos} · ${race}`;
      a.gwImpact = pos===1 ? 8+r()*4 : pos<=3 ? 3+r()*4 : pos<=6 ? (r()-0.3)*3 : -(2+r()*5);
      a.liveEligible = false;
    } else if(a.sport === 'Tennis'){
      const tourn = TOURNAMENTS_TENNIS[Math.floor(r()*TOURNAMENTS_TENNIS.length)];
      const round = ROUNDS_TENNIS[Math.floor(r()*ROUNDS_TENNIS.length)];
      const won = r() < 0.55;
      a.gwResult = won ? 'W' : 'L';
      a.gwLine = won ? `Won ${round} · ${tourn}` : `Lost ${round} · ${tourn}`;
      a.gwImpact = won ? 3+r()*7 : -(2+r()*6);
      a.liveEligible = false;
    } else if(a.type === 'Team'){
      const oppPool = a.sport==='EPL' ? OPPONENTS_EPL : a.sport==='NFL' ? OPPONENTS_NFL : OPPONENTS_NBA;
      const opp = oppPool[Math.floor(r()*oppPool.length)];
      const allowDraw = a.sport === 'EPL';
      let result, scoreLine, impact;
      if(roll < 0.5){
        if(a.sport==='NBA'){ const gf=95+Math.floor(r()*30), ga=gf-(3+Math.floor(r()*15)); result='W'; scoreLine=`${gf}-${ga}`; }
        else { const gf=Math.floor(r()*3)+1, ga=Math.floor(r()*gf); result='W'; scoreLine=`${gf}-${ga}`; }
        impact = 2 + r()*6;
      } else if(allowDraw && roll < 0.75){
        const g=Math.floor(r()*2)+1; result='D'; scoreLine=`${g}-${g}`; impact = (r()-0.5)*2;
      } else {
        if(a.sport==='NBA'){ const ga=95+Math.floor(r()*30), gf=ga-(3+Math.floor(r()*15)); result='L'; scoreLine=`${gf}-${ga}`; }
        else { const ga=Math.floor(r()*3)+1, gf=Math.floor(r()*ga); result='L'; scoreLine=`${gf}-${ga}`; }
        impact = -(2 + r()*6);
      }
      a.gwResult = result;
      a.gwLine = `${result} ${scoreLine} vs ${opp}`;
      a.gwImpact = impact;
      a.liveEligible = true; // EPL/NFL/NBA teams — TheSportsDB free tier covers these
    } else if(a.sport==='EPL'){
      const goals = Math.floor(r()*3), assists = Math.floor(r()*2);
      a.gwLine = (goals||assists) ? `${goals}G ${assists}A this week` : 'Quiet week — no G/A';
      a.gwImpact = goals*3.5 + assists*1.8 - 1.2 + (r()-0.5)*1.5;
      a.gwResult = a.gwImpact >= 0 ? 'W' : 'L';
      a.liveEligible = false;
    } else if(a.sport==='NFL'){
      const tds = Math.floor(r()*3), yards = 60+Math.floor(r()*140);
      a.gwLine = `${yards} yds, ${tds} TD${tds!==1?'s':''}`;
      a.gwImpact = tds*3.2 + (yards-120)*0.015 + (r()-0.5)*1.5;
      a.gwResult = a.gwImpact >= 0 ? 'W' : 'L';
      a.liveEligible = false;
    } else { // NBA player
      const pts = 15+Math.floor(r()*25), ast = Math.floor(r()*10);
      a.gwLine = `${pts} pts, ${ast} ast this week`;
      a.gwImpact = (pts-25)*0.25 + ast*0.6 + (r()-0.5)*1.5;
      a.gwResult = a.gwImpact >= 0 ? 'W' : 'L';
      a.liveEligible = false;
    }
  });

  // Off-field / regulatory risk events — can tank price independently of match results
  const mcity = ASSETS.find(a => a.id === 'mcfc');
  if(mcity){
    mcity.riskEvent = {
      title: '115 charges — Premier League financial rules case',
      detail: 'Independent commission hearing into alleged breaches of top-flight financial regulations (2009–2018) is ongoing. A guilty finding could carry points deductions or a fine.',
      impact: -11.2,
    };
    mcity.price = mcity.price * (1 + mcity.riskEvent.impact/100);
    mcity.change24h = mcity.riskEvent.impact + (Math.random()*2 - 1);
    const h1 = mcity.history['1D']; h1[h1.length-1] = mcity.price;
    const spk = mcity.spark; spk[spk.length-1] = mcity.price;
  }

  const state = {
    cash: 10000,
    holdings: {},   // id -> {shares, costBasis}
    currentView: 'markets',
    currentAsset: null,
    activeFilter: 'All',
    tf: '1W',
    swapSide: 'buy',
    connected: false,
    network: 'Base',
    captainId: null,
    leagueCode: null,
  };

  function truncAddr(addr){ return addr.slice(0,6) + '…' + addr.slice(-4); }
  const USER_ADDR = mockAddress(777);
  function mockTxHash(){
    const chars = '0123456789abcdef';
    let hex = '';
    for(let i=0;i<64;i++) hex += chars[Math.floor(Math.random()*16)];
    return '0x' + hex;
  }

  function fmt(n, d=2){ return n.toLocaleString('en-US', {minimumFractionDigits:d, maximumFractionDigits:d}); }
  function fmtUSD(n, d=2){ return '$' + fmt(n, d); }
  function fmtCompact(n){
    if(n>=1e9) return '$'+(n/1e9).toFixed(2)+'B';
    if(n>=1e6) return '$'+(n/1e6).toFixed(2)+'M';
    if(n>=1e3) return '$'+(n/1e3).toFixed(1)+'K';
    return '$'+n.toFixed(0);
  }

  // ---------------- News feed ----------------
  // Headlines are generated from the same gwLine/riskEvent data driving prices —
  // so every story ties back to a real move on the asset it's about.
  const NEWS_SOURCES = { EPL:'Sky Sports', NFL:'ESPN', NBA:'The Athletic', F1:'Reuters', Tennis:'BBC Sport', Matches:'Associated Press' };
  const NEWS_TIMES = ['1h ago','2h ago','4h ago','6h ago','9h ago','13h ago','1d ago','1d ago','2d ago'];

  function buildTeamHeadline(a){
    const [resultPart, opp] = a.gwLine.split(' vs ');
    const [result, score] = resultPart.split(' ');
    if(result === 'W') return `${a.name} beat ${opp} ${score}`;
    if(result === 'L') return `${a.name} fall to ${opp} ${score}`;
    return `${a.name} held to a ${score} draw by ${opp}`;
  }

  function buildHeadline(a){
    if(a.type === 'Match') return `Preview: ${a.fixture} — kicks off ${a.kickoff}`;
    if(a.type === 'Team' && a.sport !== 'F1') return buildTeamHeadline(a);
    if(a.sport === 'F1') return `${a.name} finishes ${a.gwLine}`;
    if(a.sport === 'Tennis') return `${a.name}: ${a.gwLine}`;
    if(a.sport === 'EPL') return a.gwLine.startsWith('Quiet') ? `Quiet week for ${a.name}` : `${a.name} involved in ${a.gwLine.toLowerCase()}`;
    if(a.sport === 'NFL') return `${a.name} racks up ${a.gwLine}`;
    return `${a.name} drops ${a.gwLine}`;
  }

  function buildNewsFeed(){
    const items = ASSETS
      .filter(a => a.type !== 'Match' || a.id.endsWith('-h')) // one preview per fixture, keyed off the home outcome
      .map((a,i) => ({
        headline: buildHeadline(a),
        source: NEWS_SOURCES[a.sport] || 'Reuters',
        time: NEWS_TIMES[i % NEWS_TIMES.length],
        assetId: a.id,
        sport: a.sport,
        avatarColor: a.color,
        avatarText: a.ticker.slice(0,3),
      }));
    // shuffle deterministically-ish by sport for variety
    return items.sort((x,y)=> x.sport.localeCompare(y.sport));
  }

  const NEWS_FEED = buildNewsFeed();

  // ---------------- Breaking news engine — news that actually moves price ----------------
  const POSITIVE_BREAKING = [
    '${name} signs new long-term contract extension',
    '${name} linked with blockbuster incoming transfer',
    '${name} cleared of injury concern ahead of next fixture',
    '${name} named in this week\'s team of the week',
    '${name} lands lucrative new sponsorship deal',
    '${name} returns to training early, ahead of schedule',
  ];
  const NEGATIVE_BREAKING = [
    '${name} facing fresh injury scare in training',
    'Manager under mounting pressure after ${name}\'s poor run',
    'Disciplinary probe opened following ${name} incident',
    '${name} linked with shock departure amid unrest',
    '${name} ruled out for up to a month with injury',
    'Dressing-room unrest reported around ${name}',
  ];

  function fireBreakingNews(){
    const pool = ASSETS.filter(a => a.type !== 'Match');
    const asset = pool[Math.floor(Math.random()*pool.length)];
    const isPositive = Math.random() < 0.5;
    const templates = isPositive ? POSITIVE_BREAKING : NEGATIVE_BREAKING;
    const template = templates[Math.floor(Math.random()*templates.length)];
    const impact = isPositive ? (1.5 + Math.random()*4.5) : -(1.5 + Math.random()*7.5);
    const headline = template.replace('${name}', asset.name);

    // the news event itself moves the price — not the other way around
    asset.price = Math.max(0.01, asset.price * (1 + impact/100));
    asset.change24h += impact;
    const spk = asset.spark; spk.shift(); spk.push(asset.price);
    const h1d = asset.history['1D']; h1d.shift(); h1d.push(asset.price);

    NEWS_FEED.unshift({
      headline, source: NEWS_SOURCES[asset.sport] || 'Reuters', time: 'Just now',
      assetId: asset.id, sport: asset.sport, avatarColor: asset.color, avatarText: asset.ticker.slice(0,3),
      breaking: true, impact,
    });
