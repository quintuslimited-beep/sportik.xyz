  function setSwapTab(side){
    state.swapSide = side;
    document.getElementById('tabBuy').classList.toggle('active', side==='buy');
    document.getElementById('tabSell').classList.toggle('active', side==='sell');
    document.getElementById('payUnit').textContent = side==='buy' ? 'USD' : (state.currentAsset ? state.currentAsset.ticker : '');
    document.getElementById('receiveUnit').textContent = side==='buy' ? (state.currentAsset ? state.currentAsset.ticker : 'stakes') : 'USD';
    document.getElementById('amountInput').value = '';
    updateSwapPanel();
  }
  document.getElementById('tabBuy').addEventListener('click', ()=> setSwapTab('buy'));
  document.getElementById('tabSell').addEventListener('click', ()=> setSwapTab('sell'));

  function updateSwapPanel(){
    const a = state.currentAsset;
    if(!a) return;
    const holding = state.holdings[a.id];
    const sharesOwned = holding ? holding.shares : 0;
    document.getElementById('payBalance').textContent = state.swapSide==='buy'
      ? `Balance: ${fmtUSD(state.cash)}`
      : `Balance: ${fmt(sharesOwned,4)} ${a.ticker}`;

    const amt = parseFloat(document.getElementById('amountInput').value) || 0;
    const fee = amt * 0.003;
    let receive = 0;
    if(state.swapSide === 'buy'){
      receive = Math.max(0, (amt - fee) / a.price);
      document.getElementById('receiveOutput').value = amt ? fmt(receive, 4) : '';
    } else {
      const proceeds = amt * a.price;
      const feeAmt = proceeds * 0.003;
      receive = Math.max(0, proceeds - feeAmt);
      document.getElementById('receiveOutput').value = amt ? fmt(receive, 2) : '';
    }
    document.getElementById('priceImpact').textContent = amt ? (Math.min(amt/50000*2.4, 4.8)).toFixed(2)+'%' : '0.00%';
    document.getElementById('feeAmount').textContent = state.swapSide==='buy' ? fmtUSD(fee) : fmtUSD(amt*a.price*0.003);
    document.getElementById('gasAmount').textContent = amt ? fmtUSD(0.15 + Math.random()*0.35) : '$0.00';

    const btn = document.getElementById('swapBtn');
    if(!state.connected){
      btn.textContent = 'Connect wallet to trade';
      btn.className = 'swap-btn buy';
    } else {
      btn.textContent = state.swapSide==='buy' ? 'Buy stakes' : 'Sell stakes';
      btn.className = 'swap-btn ' + state.swapSide;
    }
  }
  document.getElementById('amountInput').addEventListener('input', updateSwapPanel);

  function showToast(msg){
    const t = document.getElementById('toast');
    document.getElementById('toastMsg').textContent = msg;
    t.classList.add('show');
    clearTimeout(t._timer);
    t._timer = setTimeout(()=> t.classList.remove('show'), 2600);
  }

  document.getElementById('swapBtn').addEventListener('click', ()=>{
    if(!state.connected){ document.getElementById('connectBtn').click(); return; }
    const a = state.currentAsset;
    const amt = parseFloat(document.getElementById('amountInput').value) || 0;
    if(amt <= 0){ showToast('Enter an amount first.'); return; }

    if(state.swapSide === 'buy'){
      if(amt > state.cash){ showToast('Insufficient cash balance.'); return; }
      const fee = amt * 0.003;
      const sharesBought = (amt - fee) / a.price;
      state.cash -= amt;
      const h = state.holdings[a.id] || { shares:0, costBasis:0 };
      h.costBasis = (h.costBasis * h.shares + (amt-fee)) / (h.shares + sharesBought || 1);
      h.shares += sharesBought;
      state.holdings[a.id] = h;
      showToast(`Confirmed · bought ${fmt(sharesBought,4)} ${a.ticker} · tx ${truncAddr(mockTxHash())}`);
    } else {
      const h = state.holdings[a.id];
      const owned = h ? h.shares : 0;
      if(amt > owned){ showToast(`You only hold ${fmt(owned,4)} ${a.ticker}.`); return; }
      const proceeds = amt * a.price;
      const fee = proceeds * 0.003;
      state.cash += (proceeds - fee);
      h.shares -= amt;
      if(h.shares < 0.0001) delete state.holdings[a.id];
      showToast(`Confirmed · sold ${fmt(amt,4)} ${a.ticker} · tx ${truncAddr(mockTxHash())}`);
    }
    document.getElementById('amountInput').value = '';
    updateWalletDisplay();
    updateSwapPanel();
    renderDetail();
  });

  function updateWalletDisplay(){
    document.getElementById('walletBalance').textContent = fmtUSD(state.cash);
  }

  // ---------------- Portfolio ----------------
  function renderPortfolio(){
    let holdingsValue = 0, costTotal = 0, gwPointsTotal = 0;
    const rows = Object.entries(state.holdings).map(([id, h])=>{
      const a = ASSETS.find(x=>x.id===id);
      const value = h.shares * a.price;
      const cost = h.shares * h.costBasis;
      holdingsValue += value; costTotal += cost;
      const pnl = value - cost;
      const pnlPct = cost ? (pnl/cost*100) : 0;
      const isCaptain = state.captainId === id;
      const pts = Math.round(a.gwImpact * 2) * (isCaptain ? 2 : 1);
      gwPointsTotal += pts;
      return { a, h, value, cost, pnl, pnlPct, isCaptain, pts };
    }).sort((x,y)=> y.value - x.value);

    const body = document.getElementById('holdingsBody');
    if(rows.length === 0){
      body.innerHTML = `<tr><td colspan="8"><div class="empty-state">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 17 L9 10 L14 14 L21 5"/></svg>
        <p>No holdings yet — head to Markets to buy your first stakes.</p></div></td></tr>`;
    } else {
      body.innerHTML = rows.map(r=>{
        const up = r.pnl >= 0;
        const ptsUp = r.pts >= 0;
        return `<tr class="clickable" data-id="${r.a.id}">
          <td><button class="captain-btn ${r.isCaptain?'active':''}" data-cap="${r.a.id}" title="${r.isCaptain?'Captain — 2× points':'Make captain'}">C</button></td>
          <td><div class="row-token"><div class="mini-avatar" style="background:${r.a.color}">${r.a.ticker.slice(0,3)}</div>
            <div>${r.a.name}<div style="font-size:11px;color:var(--text-tertiary)">${r.a.ticker}</div></div></div></td>
          <td class="cell-mono">${fmt(r.h.shares,4)}</td>
          <td class="cell-mono">$${fmt(r.h.costBasis)}</td>
          <td class="cell-mono">$${fmt(r.a.price)}</td>
          <td class="cell-mono">${fmtUSD(r.value)}</td>
          <td class="cell-mono" style="color:${up?'var(--teal)':'var(--red)'}">${up?'+':''}${fmtUSD(r.pnl)} (${r.pnlPct.toFixed(2)}%)</td>
          <td class="cell-mono" style="color:${ptsUp?'var(--teal)':'var(--red)'}">${ptsUp?'+':''}${r.pts}${r.isCaptain?' ⓒ':''}</td>
        </tr>`;
      }).join('');
      body.querySelectorAll('tr.clickable').forEach(tr=>{
        tr.addEventListener('click', ()=> openDetail(tr.dataset.id));
      });
      body.querySelectorAll('.captain-btn').forEach(btn=>{
        btn.addEventListener('click', (e)=>{
          e.stopPropagation();
          state.captainId = (state.captainId === btn.dataset.cap) ? null : btn.dataset.cap;
          renderPortfolio();
        });
      });
    }

    document.getElementById('pfGwPoints').textContent = gwPointsTotal;

    const total = state.cash + holdingsValue;
    const pnl = holdingsValue - costTotal;
    const pnlPct = costTotal ? (pnl/costTotal*100) : 0;
    document.getElementById('pfTotal').textContent = fmtUSD(total);
    document.getElementById('pfCash').textContent = fmtUSD(state.cash);
    document.getElementById('pfHoldings').textContent = fmtUSD(holdingsValue);
    const pnlEl = document.getElementById('pfPnl');
    pnlEl.textContent = (pnl>=0?'+':'') + fmtUSD(pnl);
    pnlEl.style.color = pnl>=0 ? 'var(--teal)' : 'var(--red)';
    document.getElementById('pfPnlPct').textContent = (pnl>=0?'+':'') + pnlPct.toFixed(2) + '%';
    document.getElementById('pfPnlPct').style.color = pnl>=0 ? 'var(--teal)' : 'var(--red)';
  }

  // ---------------- Leaderboard (mock) ----------------
  const TRADERS = [
    { name:'0x4f...9aB2', top:'Haaland', ret:82.4, val:184320 },
    { name:'quantpitch',  top:'Man City', ret:64.1, val:132870 },
    { name:'0x9e...11Cd', top:'Chiefs', ret:51.7, val:98410 },
    { name:'saka_stan',   top:'Saka', ret:44.9, val:76200 },
    { name:'0x2a...77Ff', top:'Salah', ret:38.2, val:69850 },
    { name:'gridiron_dao',top:'Eagles', ret:29.6, val:55130 },
    { name:'0x8c...42Aa', top:'Arsenal', ret:21.3, val:41220 },
  ];
  const LEAGUE_FRIENDS = [
    { name:'jordan_p',  captain:'Haaland', pts:71 },
    { name:'0x3d...5eA1',captain:'Mahomes', pts:58 },
    { name:'maya_fc',   captain:'Salah', pts:52 },
    { name:'0x7b...c40f',captain:'Man City', pts:44 },
  ];
  function renderLeaderboard(){
    const body = document.getElementById('leaderboardBody');
    body.innerHTML = TRADERS.map((t,i)=>{
      const rank = i+1;
      return `<tr>
        <td><span class="rank-badge ${rank<=3?'gold':''}">${rank}</span></td>
        <td class="cell-mono">${t.name}</td>
        <td>${t.top}</td>
        <td class="cell-mono" style="color:var(--teal)">+${t.ret.toFixed(1)}%</td>
        <td class="cell-mono">${fmtUSD(t.val)}</td>
      </tr>`;
    }).join('');
    renderMyLeague();
  }

  function renderMyLeague(){
    if(!state.leagueCode) return;
    const holdingsValue = Object.entries(state.holdings).reduce((sum,[id,h])=>{
      const a = ASSETS.find(x=>x.id===id);
      return sum + h.shares * a.price;
    }, 0);
    const myTotal = state.cash + holdingsValue;
    const myPts = parseInt(document.getElementById('pfGwPoints').textContent) || 0;
    const capAsset = state.captainId ? ASSETS.find(a=>a.id===state.captainId) : null;

    const all = LEAGUE_FRIENDS.map(f=>({...f}))
      .concat([{ name:'You', captain: capAsset ? capAsset.name : '—', pts: myPts, val: myTotal, you:true }]);
    all.forEach(f=>{ if(f.val === undefined) f.val = 40000 + f.pts*900; });
    all.sort((x,y)=> y.pts - x.pts);

    document.getElementById('myLeagueBody').innerHTML = all.map((f,i)=>`
      <tr class="${f.you?'you-row':''}">
        <td><span class="rank-badge ${i===0?'gold':''}">${i+1}</span></td>
        <td class="cell-mono">${f.name}</td>
        <td>${f.captain}</td>
        <td class="cell-mono" style="color:var(--teal)">${f.pts}</td>
        <td class="cell-mono">${fmtUSD(f.val)}</td>
      </tr>`).join('');
  }

  document.getElementById('createLeagueBtn').addEventListener('click', ()=>{
    const code = 'FX-' + Math.random().toString(36).slice(2,7).toUpperCase();
    state.leagueCode = code;
    document.getElementById('leagueSub').textContent = 'Share this code with friends — ranked by gameweek points, captain included.';
    document.getElementById('leagueAction').innerHTML = `<div class="league-code">${code}</div>`;
    document.getElementById('myLeaguePanel').hidden = false;
    renderMyLeague();
    showToast('League created — invite code copied to share.');
  });

  // ---------------- Integrations ----------------
  const PARTNER_VENUES = [
    { name:'Kraken',    type:'Exchange', status:'live' },
    { name:'Bybit',     type:'Exchange', status:'live' },
    { name:'Robinhood', type:'Broker',   status:'live' },
    { name:'Revolut',   type:'Broker',   status:'live' },
    { name:'Backpack',  type:'Exchange', status:'live' },
    { name:'Wintermute',type:'Market maker', status:'live' },
    { name:'eToro',     type:'Broker',   status:'pending' },
    { name:'OKX',       type:'Exchange', status:'pending' },
  ];

  function renderIntegrations(){
    const grid = document.getElementById('partnerGrid');
    grid.innerHTML = PARTNER_VENUES.map((p,i)=>`
      <div class="partner-card">
        <div class="partner-logo" style="background:${colorFor(i+3)}22; color:${colorFor(i+3)}">${p.name.slice(0,2).toUpperCase()}</div>
        <div>
          <div class="partner-name">${p.name}</div>
          <div class="partner-meta" style="color:${p.status==='live'?'var(--teal)':'var(--gold)'}">
            <span class="partner-status-dot ${p.status}"></span>${p.type} · ${p.status==='live'?'Live':'Pending'}
          </div>
        </div>
      </div>`).join('');
    document.getElementById('intVenueCount').textContent = PARTNER_VENUES.filter(p=>p.status==='live').length;

    const sample = ASSETS[0];
    document.getElementById('codeSnippetPrice').innerHTML =
`<span class="c">// GET current price + gameweek performance</span>
<span class="k">GET</span> https://api.fixture.xyz/v1/assets/<span class="s">${sample.ticker}</span>

<span class="c">// response</span>
{
  <span class="k">"ticker"</span>: <span class="s">"${sample.ticker}"</span>,
  <span class="k">"price"</span>: ${sample.price.toFixed(2)},
  <span class="k">"contract"</span>: <span class="s">"${sample.contract}"</span>,
  <span class="k">"chain"</span>: <span class="s">"${state.network}"</span>,
  <span class="k">"gwImpact"</span>: ${sample.gwImpact.toFixed(1)}
}`;

    document.getElementById('codeSnippetOrder').innerHTML =
`<span class="c">// Route a buy order through your venue</span>
<span class="k">POST</span> https://api.fixture.xyz/v1/orders

{
  <span class="k">"ticker"</span>: <span class="s">"${sample.ticker}"</span>,
  <span class="k">"side"</span>: <span class="s">"buy"</span>,
  <span class="k">"amountUsd"</span>: 250.00,
  <span class="k">"venue"</span>: <span class="s">"your-exchange-id"</span>,
  <span class="k">"wallet"</span>: <span class="s">"0xUserAddress..."</span>
}`;
  }

  document.getElementById('requestIntegrationBtn').addEventListener('click', ()=>{
    showToast('Integration request sent — our team will follow up within 48h.');
  });
  document.getElementById('applyIntegrationBtn').addEventListener('click', ()=>{
    showToast('Application submitted — check your inbox for next steps.');
  });
  document.getElementById('viewDocsBtn').addEventListener('click', ()=>{
    document.querySelector('#codeSnippetPrice').scrollIntoView({behavior:'smooth', block:'center'});
  });

  // ---------------- Live price simulation ----------------
  function tickPrices(){
    ASSETS.forEach(a=>{
      const drift = (Math.random()-0.497) * a.price * 0.006;
      a.price = Math.max(a.base*0.3, a.price + drift);
      a.change24h += (Math.random()-0.5) * 0.15;
      a.spark.shift(); a.spark.push(a.price);
      const hist1D = a.history['1D']; hist1D.shift(); hist1D.push(a.price);
    });
    renderTicker();
    if(state.currentView === 'markets') renderMarketGrid();
    if(state.currentView === 'detail' && state.currentAsset){
      renderDetail();
    }
    if(state.currentView === 'portfolio') renderPortfolio();
  }

  // ---------------- Init ----------------
  renderFilters();
  document.getElementById('gwLabel').textContent = GAMEWEEK;
  renderTicker();
  renderMarketGrid();
  updateWalletDisplay();
  tickChain();
  setInterval(tickPrices, 2200);
  setInterval(tickChain, 3000);
  tickDeadline();
  setInterval(tickDeadline, 1000);
  hydrateLiveResults();
  setInterval(()=>{ if(state.currentView==='listings') tickAuction(); }, 1000);
  setTimeout(fireBreakingNews, 9000);
  setInterval(fireBreakingNews, 26000);

  window.addEventListener('resize', ()=>{
    if(state.currentView === 'detail') drawDetailChart();
    if(state.currentView === 'markets') renderMarketGrid();
  });

})();
</script>
