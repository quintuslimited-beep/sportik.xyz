<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Fixture — Tokenized Sports Exchange</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg-void:#080B0E;
    --bg-panel:#0F1419;
    --bg-raised:#161C22;
    --bg-hover:#1B222A;
    --border:#212A32;
    --border-bright:#2E3A44;
    --teal:#1FD9B0;
    --teal-dim:#123B32;
    --red:#FF5C6C;
    --red-dim:#3A1A1E;
    --gold:#C9A54E;
    --text-primary:#EAF0F4;
    --text-secondary:#7C8894;
    --text-tertiary:#4B5560;
    --font-sans:'IBM Plex Sans', sans-serif;
    --font-mono:'IBM Plex Mono', monospace;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html,body{
    background:var(--bg-void);
    color:var(--text-primary);
    font-family:var(--font-sans);
    height:100%;
    overflow-x:hidden;
  }
  ::selection{background:var(--teal-dim); color:var(--teal);}
  ::-webkit-scrollbar{width:8px; height:8px;}
  ::-webkit-scrollbar-track{background:transparent;}
  ::-webkit-scrollbar-thumb{background:var(--border-bright); border-radius:4px;}

  a{color:inherit; text-decoration:none;}
  button{font-family:inherit; cursor:pointer;}

  .app{display:flex; min-height:100vh;}

  /* ---------- Sidebar ---------- */
  .sidebar{
    width:220px; flex-shrink:0;
    background:var(--bg-panel);
    border-right:1px solid var(--border);
    display:flex; flex-direction:column;
    padding:20px 14px;
    position:sticky; top:0; height:100vh;
  }
  .brand{
    display:flex; align-items:center; gap:10px;
    padding:6px 8px 24px 8px;
  }
  .brand-mark{
    width:30px; height:30px; flex-shrink:0;
  }
  .brand-name{font-size:16.5px; font-weight:700; letter-spacing:0.2px;}
  .brand-sub{font-size:10px; color:var(--text-tertiary); font-family:var(--font-mono); margin-top:1px;}

  .nav{display:flex; flex-direction:column; gap:2px; margin-top:6px;}
  .nav-item{
    display:flex; align-items:center; gap:11px;
    padding:10px 12px; border-radius:8px;
    color:var(--text-secondary); font-size:14px; font-weight:500;
    background:none; border:none; width:100%; text-align:left;
    transition:background .12s, color .12s;
  }
  .nav-item svg{width:17px; height:17px; flex-shrink:0;}
  .nav-item:hover{background:var(--bg-hover); color:var(--text-primary);}
  .nav-item.active{background:var(--teal-dim); color:var(--teal);}

  .sidebar-footer{margin-top:auto; padding-top:16px; border-top:1px solid var(--border); display:flex; flex-direction:column; gap:10px;}

  .network-pill{
    display:flex; align-items:center; gap:7px;
    background:var(--bg-raised); border:1px solid var(--border); border-radius:9px;
    padding:8px 10px; font-size:12px; color:var(--text-secondary); font-family:var(--font-mono);
    position:relative;
  }
  .network-dot{width:7px; height:7px; border-radius:50%; background:var(--teal); flex-shrink:0; box-shadow:0 0 6px var(--teal);}
  .network-pill select{
    background:none; border:none; color:var(--text-primary); font-family:inherit; font-size:12px;
    outline:none; flex:1; appearance:none;
  }
  .network-pill select option{background:var(--bg-raised); color:var(--text-primary);}

  .gw-pill{
    display:flex; align-items:center; justify-content:space-between; gap:6px;
    background:var(--bg-raised); border:1px solid var(--border); border-radius:9px;
    padding:8px 10px; font-size:11px; color:var(--text-tertiary);
  }
  .gw-pill b{color:var(--text-primary); font-family:var(--font-mono); font-size:12px;}

  .deadline-pill{
    background:var(--bg-raised); border:1px solid var(--border); border-radius:9px;
    padding:8px 10px; font-size:10.5px; color:var(--text-tertiary);
  }
  .deadline-pill.locked{border-color:var(--red); background:var(--red-dim);}
  .deadline-row{display:flex; align-items:center; justify-content:space-between; margin-top:2px;}
  .deadline-time{font-family:var(--font-mono); font-size:13px; font-weight:700; color:var(--text-primary);}
  .deadline-pill.locked .deadline-time{color:var(--red);}

  .captain-btn{
    width:24px; height:24px; border-radius:6px; border:1px solid var(--border);
    background:var(--bg-raised); color:var(--text-tertiary); flex-shrink:0;
    display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:700;
  }
  .captain-btn:hover{border-color:var(--gold); color:var(--gold);}
  .captain-btn.active{background:rgba(201,165,78,0.18); border-color:var(--gold); color:var(--gold);}

  .league-panel{
    background:var(--bg-panel); border:1px solid var(--border); border-radius:12px;
    padding:16px 18px; margin-bottom:16px; display:flex; align-items:center; justify-content:space-between;
    gap:16px; flex-wrap:wrap;
  }
  .league-panel-title{font-size:14px; font-weight:600;}
  .league-panel-sub{font-size:12px; color:var(--text-secondary); margin-top:2px;}
  .league-code{
    font-family:var(--font-mono); font-size:13px; background:var(--bg-raised); border:1px solid var(--border);
    border-radius:7px; padding:8px 12px; color:var(--teal); letter-spacing:1px;
  }
  .league-btn{
    padding:9px 16px; border-radius:8px; border:1px solid var(--border-bright);
    background:var(--bg-raised); color:var(--text-primary); font-size:13px; font-weight:600;
  }
  .league-btn:hover{border-color:var(--teal); color:var(--teal);}
  .you-row{background:var(--teal-dim) !important;}

  /* Integrations */
  .int-hero{
    background:linear-gradient(135deg, var(--bg-panel), var(--bg-raised));
    border:1px solid var(--border); border-radius:14px; padding:30px 32px; margin-bottom:20px;
  }
  .int-hero-title{font-size:21px; font-weight:700; max-width:520px; letter-spacing:-0.2px;}
  .int-hero-sub{font-size:13.5px; color:var(--text-secondary); margin-top:8px; max-width:540px; line-height:1.55;}
  .int-hero-cta{display:flex; gap:10px; margin-top:20px; flex-wrap:wrap;}
  .int-cta-primary{padding:11px 20px; border-radius:9px; border:none; background:var(--teal); color:#04211B; font-size:13.5px; font-weight:700;}
  .int-cta-primary:hover{filter:brightness(1.08);}
  .int-cta-secondary{padding:11px 20px; border-radius:9px; border:1px solid var(--border-bright); background:none; color:var(--text-primary); font-size:13.5px; font-weight:600;}
  .int-cta-secondary:hover{border-color:var(--teal); color:var(--teal);}

  .int-stats{display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:20px;}
  @media (max-width:700px){.int-stats{grid-template-columns:repeat(2,1fr);}}

  .partner-grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:12px; margin-bottom:22px;}
  .partner-card{
    background:var(--bg-panel); border:1px solid var(--border); border-radius:11px; padding:14px;
    display:flex; align-items:center; gap:11px;
  }
  .partner-logo{
    width:38px; height:38px; border-radius:9px; flex-shrink:0; display:flex; align-items:center; justify-content:center;
    font-family:var(--font-mono); font-weight:700; font-size:13px;
  }
  .partner-name{font-size:13.5px; font-weight:600;}
  .partner-meta{font-size:11px; margin-top:2px; display:flex; align-items:center; gap:5px;}
  .partner-status-dot{width:6px; height:6px; border-radius:50%; flex-shrink:0;}
  .partner-status-dot.live{background:var(--teal);}
  .partner-status-dot.pending{background:var(--gold);}

  .code-block{
    background:#0B0F13; border:1px solid var(--border); border-radius:10px; padding:16px 18px;
    font-family:var(--font-mono); font-size:12px; line-height:1.7; color:#9FE8D3; overflow-x:auto; white-space:pre;
  }
  .code-block .k{color:#7CB8FF;} .code-block .s{color:#F0B86E;} .code-block .c{color:#5B6B78;}

  .int-panel-title{font-size:13px; font-weight:600; margin-bottom:10px; color:var(--text-primary);}
  .int-panel-sub{font-size:12px; color:var(--text-secondary); margin-bottom:14px;}
  .int-two-col{display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:20px;}
  @media (max-width:840px){.int-two-col{grid-template-columns:1fr;}}

  /* Auction / listings */
  .auction-panel{
    background:linear-gradient(135deg, var(--bg-panel), var(--bg-raised));
    border:1px solid var(--border); border-radius:14px; padding:26px 28px; margin-bottom:20px;
  }
  .auction-top{display:flex; align-items:flex-start; justify-content:space-between; gap:16px; flex-wrap:wrap;}
  .auction-label{font-size:10.5px; color:var(--text-tertiary); text-transform:uppercase; letter-spacing:0.6px;}
  .auction-target{font-size:19px; font-weight:700; margin-top:4px;}
  .auction-target-sub{font-size:12px; color:var(--text-secondary); margin-top:2px;}
  .auction-price-block{text-align:right;}
  .auction-price{font-family:var(--font-mono); font-size:30px; font-weight:700; color:var(--teal);}
  .auction-price-unit{font-size:12px; color:var(--text-tertiary); font-family:var(--font-mono);}
  .auction-bar-track{
    width:100%; height:8px; border-radius:5px; background:var(--bg-raised); border:1px solid var(--border);
    margin:18px 0 10px 0; overflow:hidden;
  }
  .auction-bar-fill{height:100%; background:linear-gradient(90deg, var(--teal), var(--gold)); border-radius:5px; transition:width 1s linear;}
  .auction-meta-row{display:flex; justify-content:space-between; font-size:11.5px; color:var(--text-tertiary); font-family:var(--font-mono);}
  .auction-buy-row{display:flex; align-items:center; gap:12px; margin-top:20px; flex-wrap:wrap;}
  .auction-buy-btn{
    padding:13px 24px; border-radius:9px; border:none; background:var(--teal); color:#04211B;
    font-size:14px; font-weight:700;
  }
  .auction-buy-btn:hover{filter:brightness(1.08);}
  .auction-note{font-size:11.5px; color:var(--text-tertiary);}

  .listing-steps{display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-bottom:20px;}
  @media (max-width:780px){.listing-steps{grid-template-columns:1fr;}}
  .listing-step{background:var(--bg-panel); border:1px solid var(--border); border-radius:11px; padding:16px;}
  .listing-step-num{
    width:24px; height:24px; border-radius:7px; background:var(--teal-dim); color:var(--teal);
    font-family:var(--font-mono); font-size:11.5px; font-weight:700; display:flex; align-items:center; justify-content:center;
    margin-bottom:10px;
  }
  .listing-step-title{font-size:13.5px; font-weight:600; margin-bottom:4px;}
  .listing-step-desc{font-size:12px; color:var(--text-secondary); line-height:1.5;}

  .propose-row{display:flex; gap:10px; margin-bottom:20px; flex-wrap:wrap;}
  .propose-row input{
    flex:1; min-width:220px; background:var(--bg-panel); border:1px solid var(--border); border-radius:9px;
    padding:11px 14px; color:var(--text-primary); font-family:inherit; font-size:13.5px; outline:none;
  }
  .propose-row input:focus{border-color:var(--border-bright);}
  .propose-row input::placeholder{color:var(--text-tertiary);}

  .wallet-box{
    background:var(--bg-raised); border:1px solid var(--border);
    border-radius:10px; padding:12px;
  }
  .wallet-label{font-size:10px; color:var(--text-tertiary); text-transform:uppercase; letter-spacing:0.6px;}
  .wallet-amount{font-family:var(--font-mono); font-size:17px; font-weight:600; margin-top:4px;}
  .wallet-addr{font-family:var(--font-mono); font-size:11px; color:var(--text-tertiary); margin-top:3px;}

  .connect-btn{
    width:100%; padding:11px; border-radius:9px; border:1px solid var(--teal);
    background:var(--teal-dim); color:var(--teal); font-size:13.5px; font-weight:600;
    display:flex; align-items:center; justify-content:center; gap:7px;
  }
  .connect-btn:hover{background:rgba(31,217,176,0.18);}
  .connect-btn svg{width:15px; height:15px;}

  /* ---------- Main ---------- */
  .main{flex:1; min-width:0; display:flex; flex-direction:column;}

  .ticker-bar{
    height:40px; border-bottom:1px solid var(--border);
    background:var(--bg-panel);
    display:flex; align-items:center;
    position:sticky; top:0; z-index:5;
  }
  .ticker-viewport{flex:1; min-width:0; overflow:hidden; white-space:nowrap; height:100%; display:flex; align-items:center;}
  .ticker-track{
    display:inline-flex; gap:28px; padding-left:100%;
    animation:ticker-scroll 42s linear infinite;
  }
  @keyframes ticker-scroll{
    from{transform:translateX(0);}
    to{transform:translateX(-100%);}
  }
  .ticker-item{display:inline-flex; align-items:center; gap:7px; font-family:var(--font-mono); font-size:12.5px;}
  .ticker-sym{color:var(--text-secondary);}
  .ticker-price{color:var(--text-primary); font-weight:600;}
  .ticker-chg.up{color:var(--teal);}
  .ticker-chg.down{color:var(--red);}

  .view{padding:28px 34px 60px 34px; max-width:1180px;}
  .view[hidden]{display:none;}

  .view-header{display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:22px; flex-wrap:wrap;}
  .view-title{font-size:22px; font-weight:600; letter-spacing:-0.2px;}
  .view-subtitle{font-size:13px; color:var(--text-secondary); margin-top:3px;}

  .filter-row{display:flex; gap:8px; align-items:center;}
  .pill{
    padding:7px 14px; border-radius:20px; border:1px solid var(--border);
    background:var(--bg-panel); color:var(--text-secondary); font-size:13px; font-weight:500;
    transition:all .12s;
  }
  .pill:hover{border-color:var(--border-bright); color:var(--text-primary);}
  .pill.active{background:var(--teal-dim); border-color:var(--teal); color:var(--teal);}

  .search-box{
    display:flex; align-items:center; gap:8px;
    background:var(--bg-panel); border:1px solid var(--border); border-radius:9px;
    padding:8px 12px; min-width:220px;
  }
  .search-box svg{width:15px; height:15px; color:var(--text-tertiary); flex-shrink:0;}
  .search-box input{
    background:none; border:none; outline:none; color:var(--text-primary);
    font-family:inherit; font-size:13.5px; width:100%;
  }
  .search-box input::placeholder{color:var(--text-tertiary);}

  /* Market grid */
  .market-grid{
    display:grid; grid-template-columns:repeat(auto-fill, minmax(258px, 1fr));
    gap:14px; margin-top:20px;
  }
  .token-card{
    background:var(--bg-panel); border:1px solid var(--border); border-radius:12px;
    padding:16px; cursor:pointer; transition:border-color .12s, transform .12s;
  }
  .token-card:hover{border-color:var(--border-bright); transform:translateY(-1px);}
  .token-card-top{display:flex; align-items:center; justify-content:space-between; margin-bottom:2px;}
  .token-id{display:flex; align-items:center; gap:10px;}
  .token-avatar{
    width:34px; height:34px; border-radius:8px;
    display:flex; align-items:center; justify-content:center;
    font-size:12.5px; font-weight:700; font-family:var(--font-mono);
    color:var(--bg-void);
  }
  .token-name{font-size:14.5px; font-weight:600;}
  .token-meta{font-size:11px; color:var(--text-tertiary); margin-top:1px;}
  .token-badge{
    font-size:9.5px; font-weight:600; text-transform:uppercase; letter-spacing:0.4px;
    padding:3px 7px; border-radius:5px; background:var(--bg-raised); color:var(--text-tertiary);
  }
  .token-price-row{display:flex; align-items:baseline; justify-content:space-between; margin-top:14px;}
  .token-price{font-family:var(--font-mono); font-size:19px; font-weight:600;}
  .token-chg{font-family:var(--font-mono); font-size:12.5px; font-weight:600; padding:2px 6px; border-radius:5px;}
  .token-chg.up{color:var(--teal); background:var(--teal-dim);}
  .token-chg.down{color:var(--red); background:var(--red-dim);}
  .token-gw{
    display:flex; align-items:center; gap:5px; margin-top:8px;
    font-size:11px; color:var(--text-tertiary); font-family:var(--font-mono);
  }
  .token-gw .gw-dot{width:5px; height:5px; border-radius:50%; flex-shrink:0;}
  .token-gw .gw-dot.up{background:var(--teal);}
  .token-gw .gw-dot.down{background:var(--red);}
  .sparkline{width:100%; height:40px; margin-top:10px; display:block;}

  /* Detail view */
  .back-btn{
    display:inline-flex; align-items:center; gap:6px; color:var(--text-secondary);
    font-size:13px; font-weight:500; margin-bottom:16px; background:none; border:none;
  }
  .back-btn:hover{color:var(--text-primary);}
  .back-btn svg{width:14px; height:14px;}

  .detail-header{display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px; margin-bottom:20px;}
  .detail-id{display:flex; align-items:center; gap:14px;}
  .detail-avatar{
    width:52px; height:52px; border-radius:12px; flex-shrink:0;
    display:flex; align-items:center; justify-content:center;
    font-size:17px; font-weight:700; font-family:var(--font-mono); color:var(--bg-void);
  }
  .detail-name{font-size:20px; font-weight:700;}
  .detail-meta{font-size:12.5px; color:var(--text-secondary); margin-top:2px;}
  .detail-price-block{text-align:right;}
  .detail-price{font-family:var(--font-mono); font-size:28px; font-weight:700;}
  .detail-chg{font-family:var(--font-mono); font-size:13.5px; font-weight:600; margin-top:2px;}
  .detail-chg.up{color:var(--teal);} .detail-chg.down{color:var(--red);}

  .detail-grid{display:grid; grid-template-columns:1fr 320px; gap:18px; align-items:start;}
  @media (max-width:840px){.detail-grid{grid-template-columns:1fr;}}

  .gw-panel{
    display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;
    background:var(--bg-panel); border:1px solid var(--border); border-radius:12px;
    padding:14px 18px; margin-bottom:18px;
  }
  .gw-panel-left{display:flex; align-items:center; gap:12px;}
  .gw-panel-icon{
    width:36px; height:36px; border-radius:9px; flex-shrink:0;
    display:flex; align-items:center; justify-content:center;
    font-family:var(--font-mono); font-size:13px; font-weight:700;
  }
  .gw-panel-icon.up{background:var(--teal-dim); color:var(--teal);}
  .gw-panel-icon.down{background:var(--red-dim); color:var(--red);}
  .gw-panel-title{font-size:10px; color:var(--text-tertiary); text-transform:uppercase; letter-spacing:0.5px;}
  .gw-panel-line{font-size:14px; font-weight:600; margin-top:2px;}
  .gw-panel-note{font-size:11.5px; color:var(--text-tertiary); margin-top:2px;}
  .oracle-tag{
    display:inline-flex; align-items:center; gap:5px; margin-top:6px;
    font-size:10.5px; color:var(--text-tertiary); font-family:var(--font-mono);
    background:var(--bg-raised); border:1px solid var(--border); border-radius:6px; padding:3px 8px;
  }
  .oracle-tag svg{width:11px; height:11px; color:var(--teal);}

  .risk-banner{
    display:flex; align-items:flex-start; gap:12px; margin-bottom:18px;
    background:var(--red-dim); border:1px solid var(--red); border-radius:12px; padding:14px 18px;
  }
  .risk-banner svg{width:19px; height:19px; color:var(--red); flex-shrink:0; margin-top:1px;}
  .risk-banner-title{font-size:13.5px; font-weight:700; color:#FF8A93;}
  .risk-banner-detail{font-size:12.5px; color:var(--text-secondary); margin-top:3px; line-height:1.5;}
  .risk-banner-impact{font-family:var(--font-mono); font-size:14px; font-weight:700; color:var(--red); margin-left:auto; flex-shrink:0; white-space:nowrap;}
  .risk-tag-card{
    display:inline-flex; align-items:center; gap:5px; margin-top:6px; font-size:10.5px; font-weight:600;
    color:#FF8A93; background:var(--red-dim); border:1px solid var(--red); border-radius:6px; padding:2px 7px;
  }

  /* News */
  .news-featured{
    display:flex; gap:14px; align-items:flex-start;
    background:var(--red-dim); border:1px solid var(--red); border-radius:13px; padding:18px 20px; margin-bottom:18px;
    cursor:pointer;
  }
  .news-featured:hover{border-color:#FF8A93;}
  .news-featured svg{width:20px; height:20px; color:var(--red); flex-shrink:0; margin-top:2px;}
  .news-featured-tag{font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; color:#FF8A93;}
  .news-featured-head{font-size:15px; font-weight:700; margin-top:4px;}
  .news-featured-sub{font-size:12.5px; color:var(--text-secondary); margin-top:5px; line-height:1.5;}
